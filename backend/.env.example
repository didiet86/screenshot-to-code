# clone-design backend — no-vision path (spec §3.3)
# These are REQUIRED for the /generate-from-spec endpoint.
# Do NOT reuse OPENAI_API_KEY / OPENAI_BASE_URL here — those stay bound to the
# (deprecated) vision path and would collide on rollback.

# LiteLLM gateway (Chat Completions endpoint, OpenAI-compatible)
LITELLM_BASE_URL=http://localhost:4000/v1
LITELLM_API_KEY=sk-your-litellm-key
# Model name as registered in LiteLLM
LITELLM_MODEL=zai-glm-5.2

# Shared-secret guarding /generate-from-spec (spec §9.1)
CLONE_DESIGN_API_KEY=your-shared-secret

# Per-generation $ ceiling for the no-vision path (spec §4.4).
# Conservative default — re-benchmark from measured data before trusting.
NO_VISION_BUDGET_USD=1.0

# Gate for the legacy vision path (spec §6). Default off.
VISION_ENABLED=false

# --- Legacy vision path (deprecated, only used when VISION_ENABLED=true) -----
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
